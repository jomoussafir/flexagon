{
  "name": "flexagon",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "description": "Shared repository for the WordPress website, iPhone app and future Android app.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test:latex": "node --test shared/latex/tests/*.test.mjs",
    "brand:sync": "python3 tools/sync_branding.py",
    "build:web": "node tools/build-web.mjs",
    "start": "npm run build:web && node_modules/node/bin/node tools/start-web.mjs",
    "dev": "npm start",
    "test:web": "node_modules/node/bin/node tests/wordpress.test.mjs",
    "package:web": "python3 tools/package-web.py",
    "test:progress": "node --test tests/progress.test.mjs"
  },
  "devDependencies": {
    "@wp-playground/cli": "^3.1.57",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "node": "^24.18.0",
    "pdfjs-dist": "6.3.289"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
